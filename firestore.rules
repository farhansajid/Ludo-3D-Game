rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidColor(c) {
      return c is string && c in ['RED', 'GREEN', 'YELLOW', 'BLUE', 'PURPLE', 'ORANGE', 'TEAL', 'ROSE'];
    }

    function isValidWinnerColor(c) {
      return c is string && c in ['NONE', 'RED', 'GREEN', 'YELLOW', 'BLUE', 'PURPLE', 'ORANGE', 'TEAL', 'ROSE'];
    }

    function hasValidProfileKeys(data) {
      return data.keys().hasAll([
               'userId', 'displayName', 'countryCode', 'countryName',
               'score', 'coins', 'xp', 'gamesPlayed', 'gamesWon', 'capturesTotal',
               'homesReachedTotal', 'claimedMissionIds', 'unlockedItems',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'displayName', 'countryCode', 'countryName',
               'score', 'coins', 'xp', 'gamesPlayed', 'gamesWon', 'capturesTotal',
               'homesReachedTotal', 'claimedMissionIds', 'unlockedItems',
               'createdAt', 'updatedAt'
             ]);
    }

    function isValidPlayerProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.countryCode is string && data.countryCode.size() >= 2 && data.countryCode.size() <= 8 &&
             data.countryName is string && data.countryName.size() >= 1 && data.countryName.size() <= 60 &&
             data.score is int && data.score >= 0 && data.score <= 100000000 &&
             data.coins is int && data.coins >= 0 && data.coins <= 100000000 &&
             data.xp is int && data.xp >= 0 && data.xp <= 100000000 &&
             data.gamesPlayed is int && data.gamesPlayed >= 0 && data.gamesPlayed <= 1000000 &&
             data.gamesWon is int && data.gamesWon >= 0 && data.gamesWon <= 1000000 &&
             data.capturesTotal is int && data.capturesTotal >= 0 && data.capturesTotal <= 10000000 &&
             data.homesReachedTotal is int && data.homesReachedTotal >= 0 && data.homesReachedTotal <= 10000000 &&
             data.claimedMissionIds is list && data.claimedMissionIds.size() <= 100 &&
             data.unlockedItems is list && data.unlockedItems.size() <= 50 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function hasValidRoomKeys(data) {
      return data.keys().hasAll([
               'hostUid', 'roomCode', 'isPublic', 'status', 'maxPlayers',
               'memberUids', 'playerNames', 'playerColors', 'playerUids',
               'tokens', 'currentTurnColor', 'turnPhase',
               'diceValue', 'diceValue2', 'dice1Used', 'dice2Used', 'selectedDieIndex',
               'consecutiveSixes', 'turnNumber', 'lastEvent',
               'reactionEmoji', 'reactionSender', 'winnerColor', 'winnerOrder',
               'activeVoiceUids', 'callMode', 'callInitiatorUid', 'callTargetUid',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'hostUid', 'roomCode', 'isPublic', 'status', 'maxPlayers',
               'memberUids', 'playerNames', 'playerColors', 'playerUids',
               'tokens', 'currentTurnColor', 'turnPhase',
               'diceValue', 'diceValue2', 'dice1Used', 'dice2Used', 'selectedDieIndex',
               'consecutiveSixes', 'turnNumber', 'lastEvent',
               'reactionEmoji', 'reactionSender', 'winnerColor', 'winnerOrder',
               'activeVoiceUids', 'callMode', 'callInitiatorUid', 'callTargetUid',
               'createdAt', 'updatedAt'
             ]);
    }

    function isValidLudoRoom(data) {
      return data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 &&
             data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 12 && data.roomCode.matches('^[A-Z0-9_\\-]+$') &&
             data.isPublic is bool &&
             data.status is string && data.status in ['WAITING', 'PLAYING', 'FINISHED'] &&
             data.maxPlayers is int && data.maxPlayers in [2, 4, 6, 8] &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 8 &&
             data.playerNames is list && data.playerNames.size() >= 1 && data.playerNames.size() <= 8 &&
             data.playerColors is list && data.playerColors.size() >= 1 && data.playerColors.size() <= 8 && isValidColor(data.playerColors[0]) &&
             data.playerUids is list && data.playerUids.size() >= 1 && data.playerUids.size() <= 8 &&
             data.tokens is list && data.tokens.size() in [16, 24, 32] && data.tokens[0] is int &&
             isValidColor(data.currentTurnColor) &&
             data.turnPhase is string && data.turnPhase in ['ROLL', 'MOVE', 'GAME_OVER'] &&
             data.diceValue is int && data.diceValue >= 0 && data.diceValue <= 6 &&
             data.diceValue2 is int && data.diceValue2 >= 0 && data.diceValue2 <= 6 &&
             data.dice1Used is bool &&
             data.dice2Used is bool &&
             data.selectedDieIndex is int && data.selectedDieIndex in [0, 1] &&
             data.consecutiveSixes is int && data.consecutiveSixes >= 0 && data.consecutiveSixes <= 3 &&
             data.turnNumber is int && data.turnNumber >= 1 && data.turnNumber <= 100000 &&
             data.lastEvent is string && data.lastEvent.size() <= 160 &&
             data.reactionEmoji is string && data.reactionEmoji.size() <= 16 &&
             data.reactionSender is string && data.reactionSender.size() <= 60 &&
             isValidWinnerColor(data.winnerColor) &&
             data.winnerOrder is list && data.winnerOrder.size() <= 8 &&
             data.activeVoiceUids is list && data.activeVoiceUids.size() <= 8 &&
             data.callMode is string && data.callMode in ['NONE', 'GROUP', 'DIRECT'] &&
             data.callInitiatorUid is string && data.callInitiatorUid.size() <= 128 &&
             data.callTargetUid is string && data.callTargetUid.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidVoiceSignal(data) {
      return data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60 &&
             data.targetUid is string && data.targetUid.size() >= 1 && data.targetUid.size() <= 128 &&
             data.signalType is string && data.signalType in ['OFFER', 'ANSWER', 'ICE', 'AUDIO_FRAME', 'HANGUP'] &&
             data.payload is string && data.payload.size() <= 32768 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidRoomChatMessage(data) {
      return data.keys().hasAll([
               'senderUid', 'senderName', 'senderColor',
               'messageText', 'quickEmoji', 'wasFiltered', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'senderUid', 'senderName', 'senderColor',
               'messageText', 'quickEmoji', 'wasFiltered', 'createdAt'
             ]) &&
             data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60 &&
             data.senderColor is string && data.senderColor in ['RED', 'GREEN', 'YELLOW', 'BLUE', 'PURPLE', 'ORANGE', 'TEAL', 'ROSE', 'SPECTATOR'] &&
             data.messageText is string && data.messageText.size() >= 1 && data.messageText.size() <= 240 &&
             !data.messageText.lower().matches('.*(fuck|shit|bitch|asshole|bastard).*') &&
             data.quickEmoji is string && data.quickEmoji.size() <= 16 &&
             data.wasFiltered is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidAdminConfig(data) {
      return data.keys().hasAll([
               'updatedByUid', 'ownerEmail', 'customFirebaseDatabaseId',
               'turnDurationSeconds', 'winPoints', 'capturePoints', 'homePoints',
               'missionRewardMultiplier', 'announcementBanner', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'updatedByUid', 'ownerEmail', 'customFirebaseDatabaseId',
               'turnDurationSeconds', 'winPoints', 'capturePoints', 'homePoints',
               'missionRewardMultiplier', 'announcementBanner', 'updatedAt'
             ]) &&
             data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128 &&
             data.ownerEmail is string && data.ownerEmail.size() >= 1 && data.ownerEmail.size() <= 120 &&
             data.customFirebaseDatabaseId is string && data.customFirebaseDatabaseId.size() <= 128 &&
             data.turnDurationSeconds is int && data.turnDurationSeconds >= 8 && data.turnDurationSeconds <= 120 &&
             data.winPoints is int && data.winPoints >= 10 && data.winPoints <= 1000 &&
             data.capturePoints is int && data.capturePoints >= 5 && data.capturePoints <= 500 &&
             data.homePoints is int && data.homePoints >= 5 && data.homePoints <= 500 &&
             data.missionRewardMultiplier is int && data.missionRewardMultiplier >= 1 && data.missionRewardMultiplier <= 10 &&
             data.announcementBanner is string && data.announcementBanner.size() <= 200 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       hasValidProfileKeys(incoming()) &&
                       isValidPlayerProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       hasValidProfileKeys(incoming()) &&
                       isValidPlayerProfile(incoming()) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt;

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    match /appConfig/{configId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() &&
                               isValidId(configId) &&
                               incoming().updatedByUid == request.auth.uid &&
                               isValidAdminConfig(incoming());
    }

    match /rooms/{roomId} {
      allow get: if isSignedIn() &&
                    isValidId(roomId) &&
                    (request.auth.uid in existing().memberUids ||
                     existing().status in ['WAITING', 'PLAYING', 'FINISHED']);

      allow list: if isSignedIn() &&
                     (request.auth.uid in existing().memberUids ||
                      existing().status in ['WAITING', 'PLAYING', 'FINISHED']);

      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       incoming().hostUid == request.auth.uid &&
                       request.auth.uid in incoming().memberUids &&
                       hasValidRoomKeys(incoming()) &&
                       isValidLudoRoom(incoming());

      allow update: if isSignedIn() &&
                       isValidId(roomId) &&
                       hasValidRoomKeys(incoming()) &&
                       isValidLudoRoom(incoming()) &&
                       existing().status != 'FINISHED' &&
                       incoming().hostUid == existing().hostUid &&
                       incoming().roomCode == existing().roomCode &&
                       incoming().isPublic == existing().isPublic &&
                       incoming().maxPlayers == existing().maxPlayers &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (existing().status == 'WAITING' &&
                          request.auth.uid in incoming().memberUids &&
                          incoming().memberUids.size() <= existing().maxPlayers) ||
                         (request.auth.uid in existing().memberUids &&
                          incoming().memberUids.size() == existing().memberUids.size()) ||
                         (existing().status == 'PLAYING' &&
                          !(request.auth.uid in existing().memberUids) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['reactionEmoji', 'reactionSender', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(roomId) && existing().hostUid == request.auth.uid;

      match /voiceSignals/{signalId} {
        allow get, list: if isSignedIn() &&
                            isValidId(roomId) &&
                            request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids;

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(signalId) &&
                         request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids &&
                         incoming().senderUid == request.auth.uid &&
                         incoming().keys().hasAll(['senderUid', 'senderName', 'targetUid', 'signalType', 'payload', 'createdAt']) &&
                         incoming().keys().hasOnly(['senderUid', 'senderName', 'targetUid', 'signalType', 'payload', 'createdAt']) &&
                         isValidVoiceSignal(incoming());

        allow delete: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(signalId) &&
                         request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids;
      }

      match /chatMessages/{messageId} {
        allow get, list: if isSignedIn() &&
                            isValidId(roomId) &&
                            (request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids ||
                             get(/databases/$(database)/documents/rooms/$(roomId)).data.status in ['WAITING', 'PLAYING', 'FINISHED']);

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         (request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids ||
                          get(/databases/$(database)/documents/rooms/$(roomId)).data.status in ['WAITING', 'PLAYING']) &&
                         incoming().senderUid == request.auth.uid &&
                         isValidRoomChatMessage(incoming());

        allow delete: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         (existing().senderUid == request.auth.uid ||
                          get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid == request.auth.uid);
      }
    }

    match /friendRequests/{requestId} {
      allow get, list: if isSignedIn() &&
                          request.auth.uid in existing().memberUids;

      allow create: if isSignedIn() &&
                       isValidId(requestId) &&
                       incoming().fromUid == request.auth.uid &&
                       incoming().toUid != request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       incoming().keys().hasAll([
                         'fromUid', 'fromName', 'fromCountry',
                         'toUid', 'toName', 'toCountry',
                         'status', 'memberUids', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'fromUid', 'fromName', 'fromCountry',
                         'toUid', 'toName', 'toCountry',
                         'status', 'memberUids', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().fromUid is string && incoming().fromUid.size() >= 1 && incoming().fromUid.size() <= 128 &&
                       incoming().fromName is string && incoming().fromName.size() >= 1 && incoming().fromName.size() <= 60 &&
                       incoming().fromCountry is string && incoming().fromCountry.size() >= 2 && incoming().fromCountry.size() <= 8 &&
                       incoming().toUid is string && incoming().toUid.size() >= 1 && incoming().toUid.size() <= 128 &&
                       incoming().toName is string && incoming().toName.size() >= 1 && incoming().toName.size() <= 60 &&
                       incoming().toCountry is string && incoming().toCountry.size() >= 2 && incoming().toCountry.size() <= 8 &&
                       incoming().memberUids is list &&
                       incoming().memberUids.size() == 2 &&
                       incoming().fromUid in incoming().memberUids &&
                       incoming().toUid in incoming().memberUids &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

      allow update: if isSignedIn() &&
                       isValidId(requestId) &&
                       request.auth.uid in existing().memberUids &&
                       incoming().fromUid == existing().fromUid &&
                       incoming().toUid == existing().toUid &&
                       incoming().memberUids == existing().memberUids &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().keys().hasAll([
                         'fromUid', 'fromName', 'fromCountry',
                         'toUid', 'toName', 'toCountry',
                         'status', 'memberUids', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'fromUid', 'fromName', 'fromCountry',
                         'toUid', 'toName', 'toCountry',
                         'status', 'memberUids', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().fromUid is string && incoming().fromUid.size() >= 1 && incoming().fromUid.size() <= 128 &&
                       incoming().fromName is string && incoming().fromName.size() >= 1 && incoming().fromName.size() <= 60 &&
                       incoming().fromCountry is string && incoming().fromCountry.size() >= 2 && incoming().fromCountry.size() <= 8 &&
                       incoming().toUid is string && incoming().toUid.size() >= 1 && incoming().toUid.size() <= 128 &&
                       incoming().toName is string && incoming().toName.size() >= 1 && incoming().toName.size() <= 60 &&
                       incoming().toCountry is string && incoming().toCountry.size() >= 2 && incoming().toCountry.size() <= 8 &&
                       incoming().status is string && incoming().status in ['PENDING', 'ACCEPTED', 'DECLINED'] &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (
                         (request.auth.uid == existing().toUid && incoming().status in ['ACCEPTED', 'DECLINED']) ||
                         (request.auth.uid == existing().fromUid && incoming().status == 'PENDING')
                       );

      allow delete: if isSignedIn() &&
                       isValidId(requestId) &&
                       request.auth.uid in existing().memberUids;
    }
  }
}
